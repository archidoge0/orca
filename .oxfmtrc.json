{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schemas/oxfmt/v0.41.0/config.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "trailingComma": "none",
  "ignorePatterns": [
    "cloud/**",
    ".github/actions/cloud-sql-rollout-lease/**",
    ".anti-slop-plugin/**",
    ".github/workflows/ghav-*.yml",
    ".github/actions/install-mobile-dependencies/action.y*ml",
    ".github/actions/install-node-dependencies/action.y*ml",
    ".github/actions/prepare-linux-package-fixture/action.y*ml",
    ".oxfmtrc.json"
  ]
}
